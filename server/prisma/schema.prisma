generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Ticket {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  shopName       String
  safetyIssue    String
  prodTarget     String
  prodActual     String
  affectedDnTime String
  grossDnTime    String
  majorBreakdown String
  employeeId     String
  employeeName   String
  createdAt      DateTime @default(now())
  createdByUserId String @db.ObjectId
  createdBy      User   @relation(fields:[createdByUserId], references: [userId])
}

model User{
  userId String @id @default(auto()) @map("_id") @db.ObjectId
  userName String
  userMail String
  tickets  Ticket[]
} 